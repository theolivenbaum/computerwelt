<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Monty</RootNamespace>
    <AssemblyName>Monty</AssemblyName>
    <PackageId>Computerwelt.Monty</PackageId>
    <Description>Minimal, secure Python interpreter for running LLM-written code. C# port of the Rust monty crate.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Unicode character database, which the host runtime does not expose. -->
    <EmbeddedResource Include="Runtime/UnicodeData.bin" LogicalName="Monty.Runtime.UnicodeData.bin" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Monty.SpecTests" />
    <InternalsVisibleTo Include="Monty.Tests" />
  </ItemGroup>

</Project>
